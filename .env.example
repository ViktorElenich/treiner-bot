# ═══════════════════════════════════════════════════════════════
# Настройки бота — ПРИМЕР
# Скопируй этот файл как .env и заполни свои значения
# ═══════════════════════════════════════════════════════════════

# Токен бота от @BotFather (длинная строка вроде 123456:ABC...)
BOT_TOKEN=

# Твой Telegram user ID (чтобы бот присылал заявки тебе)
# Узнать можно: напиши @userinfobot в Telegram
ADMIN_CHAT_ID=

# ЮKassa — ключи из личного кабинета yookassa.ru
# Внимание: на проде стоят БОЕВЫЕ ключи, платежи настоящие
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=

# ID закрытого канала (начинается с -100...)
# Узнать можно: добавь бота @RawDataBot в канал, он покажет ID
CHANNEL_ID=

# ID групп по тарифам (начинаются с -100...)
GROUP_GENERAL_ID=
GROUP_START_ID=
GROUP_PROGRESS_ID=
GROUP_RESULT_ID=

# Google Gemini API — ключ из aistudio.google.com
GEMINI_API_KEY=

# Прокси для Gemini через Cloudflare Worker (см. cloudflare/gemini-proxy-worker.js).
# Нужен на сервере: Google блокирует запросы с IP дата-центров Render.
# Локально можно оставить пустым — тогда запросы идут напрямую.
GEMINI_BASE_URL=

# Модель Gemini (по умолчанию gemini-3.1-flash-lite-preview,
# запасная стабильная — gemini-2.5-flash-lite)
GEMINI_MODEL=

# База данных PostgreSQL (Neon) — строка подключения из neon.tech
DATABASE_URL=

# Необязательно: контактный email для запросов к научной базе PubMed
NCBI_EMAIL=

# ID топиков в общем чате (форум-группе)
TOPIC_NUTRITION_ID=3
TOPIC_ARTICLES_ID=4

# Секретный ключ для проверки заявок с сайта
# Придумай любую длинную строку (например: my-super-secret-key-2026)
WEBHOOK_SECRET=

# URL бота на Render (появится после деплоя)
# Пример: https://treiner-bot.onrender.com
WEBHOOK_BASE_URL=

# Порт (Render задаёт автоматически, не трогай)
PORT=8080
